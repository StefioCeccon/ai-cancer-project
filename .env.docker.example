# Copy to `.env.docker` and fill in values for `docker compose --env-file .env.docker up`.
# Never commit `.env.docker`.

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Clerk (required) — create an app at https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# At least one AI provider for analysis / MDT
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
MISTRAL_API_KEY=

# Optional: let users save their own keys in Settings
API_KEY_ENCRYPTION_SECRET=

# Optional demo seeding / badge (leave false for personal self-host)
DEMO_MODE=false
NEXT_PUBLIC_DEMO_MODE=false

# Used when the `ml` compose profile is enabled
ML_SERVICE_URL=http://ml:8001
