# ─── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string (Neon, Supabase, or local)
DATABASE_URL=postgresql://user:password@host/dbname

# ─── AI Providers (configure at least one) ───────────────────────────────────
# Google Gemini — https://ai.google.dev/
GEMINI_API_KEY=

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Anthropic Claude — https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Mistral — https://console.mistral.ai/
MISTRAL_API_KEY=

# ─── Per-user API key encryption ─────────────────────────────────────────────
# Required to let users save their own AI provider keys (Settings → AI Keys).
# Keys are encrypted at rest with AES-256-GCM using this secret. Use a long,
# random string (e.g. `openssl rand -base64 48`). Keep it stable — rotating it
# makes already-stored keys undecryptable.
API_KEY_ENCRYPTION_SECRET=

# ─── ML Inference Service ─────────────────────────────────────────────────────
# Local: start with cd apps/ml-service && ./start.sh
# GCP Cloud Run: set to your deployed service URL
ML_SERVICE_URL=http://localhost:8001

# ─── Auth (Clerk) ─────────────────────────────────────────────────────────────
# Create an application at https://dashboard.clerk.com/ (name it "AI Cancer Project")
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key
# Localized auth routes (next-intl rewrites these under the active locale)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# ─── File storage (Cloudflare R2) ─────────────────────────────────────────────
# Leave ALL of these blank for local development — uploads then read/write to
# apps/web/public/uploads and are served statically (your local data is untouched).
# Set all four (account id, keys, bucket) to switch to R2: new uploads go to R2 and
# the browser streams files directly from R2 via short-lived signed URLs.
# Create a bucket + API token at https://dash.cloudflare.com/ → R2.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=ai-cancer-project-uploads
# Optional: public bucket / custom-domain base URL (not required — signed URLs are used).
R2_PUBLIC_URL=

# ─── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Set to "true" only on the public demo instance to show a "Demo data" badge.
NEXT_PUBLIC_DEMO_MODE=
# Server-side demo seeding (runtime). Set this on Vercel Production so seeding
# still runs even if NEXT_PUBLIC_DEMO_MODE was missing at build time.
DEMO_MODE=

# NEVER set to "true" on a multi-tenant / public demo — it would assign orphaned
# DB rows to whoever signs in first.
# CLAIM_ORPHAN_DATA=
